{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "sonarqube": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "--init",
        "-i",
        "--rm",
        "--pull=always",
        "-e",
        "SONARQUBE_URL",
        "-e",
        "SONARQUBE_TOKEN",
        "sonarsource/sonarqube-mcp"
      ],
      "environment": {
        "SONARQUBE_URL": "http://localhost:9000"
      },
      "enabled": true,
      "timeout": 30000
    },
    "motion": {
      "type": "remote",
      "url": "https://mcp.motion.dev",
      "enabled": true
    },
    "motion-plus": {
      "type": "remote",
      "url": "https://mcp.motion.dev/plus",
      "enabled": true
    }
  }
}
