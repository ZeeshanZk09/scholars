# ─────────────────────────────────────────────────────────────
# Scholar Higher Secondary School — Environment Variables
# Copy to `.env.local` and fill in real values.
# NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="Scholar School"

# PostgreSQL connection string — used by BOTH the application
# (src/config/env.ts) and the Prisma client (prisma/schema.prisma datasource).
# This is the single canonical database connection string.
DATABASE_POSTGRES_URL="postgresql://USER:PASSWORD@localhost:5432/scholar_school?schema=public"

# Auth.js (Auth v5 beta)
AUTH_SECRET="generate-with: npx auth secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Seed accounts — use unique development credentials and never commit `.env`.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_CMS_ADMIN_EMAIL="cms@example.com"
SEED_CMS_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_EDITOR_EMAIL="editor@example.com"
SEED_EDITOR_PASSWORD="replace-with-a-strong-password"